# Dependencies
node_modules/
dist/
.npm-cache/

# Env
.env
.env.local
.env.*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Sessions — contienen storageState de WhatsApp Web. NUNCA subirlos.
# Cubre tanto raíz como apps/worker-publish/sessions/.
sessions/
!sessions/.gitkeep
**/sessions/
!**/sessions/.gitkeep

# Test assets (media de prueba — se regeneran localmente)
test-assets/*
!test-assets/.gitkeep

# Local SQLite (incluye sidecar WAL/SHM)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Logs
logs/
.logs/
*.log
npm-debug.log*

# Debug dumps (screenshot + HTML cuando falla un envío)
debug/
**/debug/

# Notas locales de producción — no versionar
/docs/PRODUCTION-NOTES.local.md

# TypeScript build cache
*.tsbuildinfo

# Legacy artifacts del scaffold inicial
*.old

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Claude/Cowork scratch
.claude/
