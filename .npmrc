legacy-peer-deps=true

# Silenciamos `npm audit` durante `npm install`. Las vulnerabilidades que
# reporta este repo son devDependencies (esbuild en drizzle-kit, ws en pm2)
# que no afectan al runtime de producción. `npm audit fix --force` sube
# versiones major incompatibles y rompe el build silenciosamente.
# Quítalo si haces auditorías deliberadas.
audit=false
fund=false
